		"@tailwindcss/vite": "^4.0.0",
		"@types/jszip": "^3.4.0",
		"eslint": "^10.8",
		"eslint-config-prettier": "^10.0.1",
		"eslint-plugin-svelte": "^3.0.0",
		"globals": "^17.9",
		"prettier": "^3.4.2",
		"prettier-plugin-svelte": "^4.1",
		"prettier-plugin-tailwindcss": "^0.8",
